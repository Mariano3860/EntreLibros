{
  "name": "entrelibros",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "migrate": "npm run migrate -w backend",
    "seed:local": "npm run seed:local -w backend",
    "seed:local:cleanup": "npm run seed:local:cleanup -w backend",
    "seed:local:verify": "npm run seed:local:verify -w backend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test -w backend",
    "test:frontend": "npm test -w frontend",
    "format:backend": "npm run format-all -w backend",
    "format:frontend": "npm run format-all -w frontend",
    "start:backend": "npm run start -w backend",
    "start:frontend": "npm run start -w frontend",
    "e2e:db:up": "node e2e/scripts/database.mjs up",
    "e2e:db:reset": "node e2e/scripts/database.mjs reset",
    "e2e:db:reset-empty": "node e2e/scripts/database.mjs reset-empty",
    "e2e:db:seed": "node e2e/scripts/database.mjs seed",
    "e2e:db:cleanup": "node e2e/scripts/database.mjs cleanup",
    "e2e:install": "playwright install chromium",
    "e2e:test:backend": "node e2e/scripts/run-backend-tests.mjs",
    "e2e:test:frontend": "npm run test:frontend",
    "e2e:test:integration": "npm run e2e:test:backend",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "prod": "npm run build:backend && npm run build:frontend && npm-run-all --parallel start:backend start:frontend",
    "format-all": "npm run format:backend && npm run format:frontend",
    "complete-check:backend": "npm run complete-check -w backend",
    "complete-check:frontend": "npm run complete-check -w frontend",
    "complete-check": "npm run complete-check:backend && npm run complete-check:frontend",
    "format:check:backend": "npm run format -w backend",
    "format:check:frontend": "npm run format -w frontend",
    "lint:backend": "npm run lint -w backend",
    "lint:frontend": "npm run lint -w frontend",
    "stylelint:frontend": "npm run stylelint -w frontend",
    "typecheck:backend": "npm run typecheck -w backend",
    "typecheck:frontend": "npm run typecheck -w frontend",
    "verify:e2e": "npm-run-all --sequential e2e:test:integration e2e",
    "verify:ci": "npm-run-all --sequential format:check:backend format:check:frontend lint:backend lint:frontend stylelint:frontend typecheck:backend typecheck:frontend e2e:test:integration test:frontend build:backend build:frontend e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "npm-run-all": "^4.1.5",
    "pg": "^8.13.1"
  }
}
